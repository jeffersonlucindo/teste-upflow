# Copie este arquivo para .env.local (que nunca é versionado) e preencha os valores.

# TMDB: API Read Access Token (v4), enviado como Bearer. Crie em https://www.themoviedb.org/settings/api
# Lido só no servidor. Nunca use o prefixo NEXT_PUBLIC_: ele colocaria o token no bundle do browser.
TMDB_API_READ_TOKEN=

# Idioma das respostas do TMDB.
TMDB_LANGUAGE=pt-BR

# Opcional. 1 ou true liga cacheComponents + partialPrefetching no next.config.ts (shell estático
# e prefetch parcial). Desligado é o padrão e o código vale nos dois modos. Ver README > Flags.
# CATALOGO_CACHE_COMPONENTS=1
